{
  "name": "import-cost-monorepo",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint": "npx @biomejs/biome check .",
    "lint:fix": "npx @biomejs/biome check --write .",
    "test": "npm run build -w import-cost-core && npm run test --workspaces --if-present",
    "build": "npm run build -w import-cost-core && npm run build -w coc-import-cost-fast -w fast-import-cost"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^22.20.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "mocha": {
      "serialize-javascript": "^7.0.5",
      "diff": "^8.0.3"
    },
    "coc.nvim": {
      "@types/node": "$@types/node",
      "typescript": "^7.0.2"
    }
  },
  "lint-staged": {
    "*.{js,ts,mts,cts,mjs}": "npx @biomejs/biome check --write"
  }
}
